# Copy this file to .env and fill it in. Never commit .env.

# --- Bank connections (Plaid) -------------------------------------------------
# Get keys at https://dashboard.plaid.com -> Developers -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = fake test banks (user_good / pass_good); production = your real accounts
PLAID_ENV=sandbox
# Comma-separated: US, CA, GB, IE, FR, ES, NL, DE ...
PLAID_COUNTRY_CODES=US
# Only needed for banks that use OAuth (e.g. Chase, Wells Fargo) in production.
# Must also be registered under "Allowed redirect URIs" in the Plaid dashboard (https required,
# except http://localhost is allowed in sandbox).
# PLAID_REDIRECT_URI=http://localhost:3000/

# How often to pull new transactions while the app runs (0 = only when you click "Sync now")
SYNC_INTERVAL_HOURS=6

# --- App ----------------------------------------------------------------------
PORT=3000
# Keep 127.0.0.1 so the app (and your financial data) is only reachable from this computer.
# Only use 0.0.0.0 behind an HTTPS reverse proxy (then also set COOKIE_SECURE=true and TRUST_PROXY=1).
HOST=127.0.0.1
# COOKIE_SECURE=true
# TRUST_PROXY=1
# Where the SQLite database lives
# DATA_DIR=./data
# Bank access tokens are encrypted with this. If unset, a random key is generated in DATA_DIR/.secret_key.
# ENCRYPTION_KEY=
